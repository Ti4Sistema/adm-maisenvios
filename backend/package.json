{
  "name": "adm-maisenvios-backend",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "tsc -p tsconfig.test.json && node --env-file-if-exists=.env --test --test-concurrency=1 \"dist-test/**/*.spec.js\"",
    "migration:generate": "nest build && typeorm -d dist/database/data-source.js migration:generate",
    "migration:run": "nest build && typeorm -d dist/database/data-source.js migration:run",
    "migration:revert": "nest build && typeorm -d dist/database/data-source.js migration:revert",
    "seed:admin": "nest build && node dist/database/seed-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
